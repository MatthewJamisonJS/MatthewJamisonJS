name: Update PR Count

on:
  schedule:
    - cron: '0 0 * * *'  # daily at midnight UTC
  workflow_dispatch:  # allows manual trigger

jobs:
  update-count:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Get merged PR count
        run: |
          RESPONSE=$(curl -s "https://api.github.com/search/issues?q=author:MatthewJamisonJS+is:merged+is:pr&per_page=1")
          COUNT=$(echo $RESPONSE | jq '.total_count')
          echo '{"count": '$COUNT'}' > pr-count.json
      
      - name: Commit & push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.githubusercontent.com"
          git add pr-count.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "chore: update pr count" && git push)
